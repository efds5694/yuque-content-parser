{
  "name": "yuque-content-parser",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "一键读取当前语雀文档或解析 .lake 文件并导出 Markdown、HTML 与 JSON",
  "scripts": {
    "test": "npm run test:unit && npm run check",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "check": "node scripts/check-extension.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
